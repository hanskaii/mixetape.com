{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "@phosphor-icons/react",
            "message": "Import each icon from its own file, e.g. @phosphor-icons/react/ArrowLeft: the package root makes the dev server load all 1,500 icons."
          }
        ]
      }
    ]
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": [
    "worker-configuration.d.ts",
    "routeTree.gen.ts",
    ".wrangler/**",
    "dist/**",
    ".nitro/**",
    ".output/**",
    ".claude/**",
    ".agents/**",
    "docs/**"
  ]
}
