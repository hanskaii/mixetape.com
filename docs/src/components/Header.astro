---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden. Default `true`.
   */
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;

// The app, where people supervise what their agents schedule.
const WORKSPACE = "https://mixetape.com/publish";

// The top-level areas of the docs; each is active on the pages under its prefixes.
const NAV = [
  { label: "Guides", href: "/introduction", match: ["/introduction", "/quickstart", "/tips", "/concepts"] },
  { label: "Agents", href: "/connect-an-agent/mcp", match: ["/connect-an-agent"] },
  { label: "Tools", href: "/tools", match: ["/tools"] },
  { label: "Platforms", href: "/platforms/youtube", match: ["/platforms"] },
  { label: "API", href: "/api", match: ["/api"] },
];

const currentSlug =
  stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";
const isActive = (match: string[]) =>
  match.some((prefix) => currentSlug === prefix || currentSlug.startsWith(`${prefix}/`));
const href = (path: string) => withBase(path, import.meta.env.BASE_URL);
---

<header class="sticky top-0 z-30 border-b border-border bg-background/85 backdrop-blur-lg backdrop-saturate-150">
  <div class="mx-auto flex items-center justify-between gap-3 h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <!-- As wide as the sidebar (less the header's padding, the gap and the nav's margin), so
           the section links start over the content column and their divider meets the
           sidebar's edge. -->
      <a
        href={href("/introduction")}
        aria-label={`${config.title} docs`}
        class="group flex items-center gap-2 no-underline lg:w-[calc(var(--nb-sidebar-width)-3.25rem-1px)] lg:shrink-0"
      >
        <span
          aria-hidden="true"
          class="flex h-[22px] w-[22px] shrink-0 items-center justify-center rounded-md bg-brand text-brand-foreground"
        >
          <svg viewBox="0 0 298 233" fill="none" class="h-[13px] w-[13px]">
            <path
              fill="currentColor"
              d="M253.5 0c25 0 44 11 43.5 49.5s3.89 137.429-6.5 166c-6 16.5-25 21.13-42.5 14-13.5-5.5-51.5-37.5-56.5-49-4.999-11.5 3.001-16 15.5-15s38 4.5 38-23.5 4-47.5-20.5-47.5H73.004c-24.5 0-20.5 19.5-20.5 47.5s25.5 24.5 38 23.5 20.5 3.5 15.5 15-43 43.5-56.5 49c-17.5 7.129-36.5 2.5-42.5-14-10.39-28.571-6-127.5-6.5-166S19.004 0 44.004 0c18.345 0 69.221 36.738 98.224 59.668 2.69 2.127 10.36 2.127 13.05 0C184.28 36.738 235.155.001 253.5 0"
            />
            <path
              fill="currentColor"
              d="M77 132.5c0-9.113 7.387-16.5 16.5-16.5s16.5 7.387 16.5 16.5-7.387 16.5-16.5 16.5S77 141.613 77 132.5m110 0c0-9.113 7.387-16.5 16.5-16.5s16.5 7.387 16.5 16.5-7.387 16.5-16.5 16.5-16.5-7.387-16.5-16.5"
            />
          </svg>
        </span>
        <span class="text-[1.2rem] font-bold leading-none tracking-[-0.07em] text-foreground">
          {config.title}
        </span>
        <span class="text-foreground/70 border-border-strong hidden rounded-md border px-1.5 py-0.5 text-[11px] leading-none font-semibold tracking-[0.08em] uppercase sm:inline-block">
          Docs
        </span>
      </a>

      <nav aria-label="Sections" class="border-border ml-4 hidden h-6 min-w-0 items-center gap-1 overflow-x-auto border-l pl-4 md:flex [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {NAV.map((item) => {
          const active = isActive(item.match);
          return (
            <a
              href={href(item.href)}
              aria-current={active ? "page" : undefined}
              class:list={[
                "rounded-md px-2 py-1 text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
                active
                  ? "text-foreground bg-accent"
                  : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      {config.search !== false && <SearchTrigger />}
      <ThemeToggle />
      <a
        href={WORKSPACE}
        class="hidden sm:inline-flex items-center gap-1.5 rounded-lg bg-brand px-3 py-2 text-[0.8125rem] font-semibold text-brand-foreground no-underline transition-colors hover:bg-brand-hover"
      >
        Workspace
        <Icon name="ph:arrow-right-bold" class="w-3.5 h-3.5" />
      </a>
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label="Open navigation"
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
