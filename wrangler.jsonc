{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixetape",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // The app lives on mixetape.com only; workers.dev would be a second origin for auth.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mixetape.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "mixetape-db",
      "database_id": "4887c51e-32e1-4b2e-88b1-63e8c3b9d148",
      "migrations_dir": "src/database/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KIT_CACHE",
      "id": "84fbf589d26d45c98d6377da1e695eba",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mixetape-media",
    },
  ],
  // One durable instance per scheduled post; see src/modules/social/publish.workflow.ts.
  "workflows": [
    {
      "name": "mixetape-publish",
      "binding": "PUBLISH_WORKFLOW",
      "class_name": "PublishWorkflow",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  // Production credentials live in the account's Secrets Store (default_secrets_store) and are
  // read through src/modules/secrets/secrets.service.ts, which falls back to .dev.vars locally.
  "secrets_store_secrets": [
    {
      "binding": "SS_BETTER_AUTH_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-better-auth-secret",
    },
    {
      "binding": "SS_CREDENTIALS_KEY",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-credentials-key",
    },
    {
      "binding": "SS_GITHUB_CLIENT_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-github-client-id",
    },
    {
      "binding": "SS_GITHUB_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-github-client-secret",
    },
    {
      "binding": "SS_GOOGLE_CLIENT_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-google-client-id",
    },
    {
      "binding": "SS_GOOGLE_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-google-client-secret",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "mixetape",
    "SITE_URL": "https://mixetape.com",
    "BETTER_AUTH_URL": "https://mixetape.com",
    "EMAIL_FROM": "no-reply@mixetape.com",
  },
}
