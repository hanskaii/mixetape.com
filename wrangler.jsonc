{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mixetape",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // The app lives on mixetape.com only; workers.dev would be a second origin for auth.
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mixetape.com",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "mixetape-db",
      "database_id": "4887c51e-32e1-4b2e-88b1-63e8c3b9d148",
      "migrations_dir": "src/database/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KIT_CACHE",
      "id": "84fbf589d26d45c98d6377da1e695eba",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "mixetape-media",
    },
  ],
  // Hourly at :17: storage expiry and stale idempotency keys (src/server.ts scheduled).
  "triggers": { "crons": ["17 * * * *"] },
  // API calls per user (REST and MCP tools): 120 a minute, then 429 with Retry-After.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1701",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  // One durable instance per scheduled post; see src/modules/social/publish.workflow.ts.
  "workflows": [
    {
      "name": "mixetape-publish",
      "binding": "PUBLISH_WORKFLOW",
      "class_name": "PublishWorkflow",
    },
    {
      // One webhook delivery, retried with backoff (modules/webhooks).
      "name": "mixetape-webhooks",
      "binding": "WEBHOOK_WORKFLOW",
      "class_name": "WebhookWorkflow",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  // Production credentials live in the account's Secrets Store (default_secrets_store) and are
  // read through src/modules/secrets/secrets.service.ts, which falls back to .dev.vars locally.
  "secrets_store_secrets": [
    {
      "binding": "SS_BETTER_AUTH_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-better-auth-secret",
    },
    {
      "binding": "SS_CREDENTIALS_KEY",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-credentials-key",
    },
    {
      "binding": "SS_GITHUB_CLIENT_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-github-client-id",
    },
    {
      "binding": "SS_GITHUB_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-github-client-secret",
    },
    {
      "binding": "SS_GOOGLE_CLIENT_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-google-client-id",
    },
    {
      "binding": "SS_GOOGLE_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-google-client-secret",
    },
    {
      "binding": "SS_R2_ACCESS_KEY_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-r2-access-key-id",
    },
    {
      "binding": "SS_R2_SECRET_ACCESS_KEY",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-r2-secret-access-key",
    },
    // mixetape's own app on each platform, which every channel connects through
    // (social.service#APPS).
    {
      "binding": "SS_YOUTUBE_CLIENT_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-youtube-client-id",
    },
    {
      "binding": "SS_YOUTUBE_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-youtube-client-secret",
    },
    {
      "binding": "SS_FACEBOOK_APP_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-facebook-app-id",
    },
    {
      "binding": "SS_FACEBOOK_APP_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-facebook-app-secret",
    },
    {
      "binding": "SS_INSTAGRAM_APP_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-instagram-app-id",
    },
    {
      "binding": "SS_INSTAGRAM_APP_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-instagram-app-secret",
    },
    {
      "binding": "SS_THREADS_APP_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-threads-app-id",
    },
    {
      "binding": "SS_THREADS_APP_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-threads-app-secret",
    },
    {
      "binding": "SS_TIKTOK_CLIENT_KEY",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-tiktok-client-key",
    },
    {
      "binding": "SS_TIKTOK_CLIENT_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-tiktok-client-secret",
    },
    {
      "binding": "SS_PINTEREST_APP_ID",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-pinterest-app-id",
    },
    {
      "binding": "SS_PINTEREST_APP_SECRET",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-pinterest-app-secret",
    },
    {
      // Bluesky OAuth: mixetape's ES256 private key as a JWK (providers/bluesky).
      "binding": "SS_BLUESKY_PRIVATE_KEY",
      "store_id": "40a8cda5c5604b1f8c73604e3f5ca575",
      "secret_name": "mixetape-bluesky-private-key",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "mixetape",
    "SITE_URL": "https://mixetape.com",
    "BETTER_AUTH_URL": "https://mixetape.com",
    "EMAIL_FROM": "no-reply@mixetape.com",
    // Where presigned uploads go (storage/upload.service): the bucket bound as BUCKET.
    "R2_ACCOUNT_ID": "526998f1dc79660b3b5d57b5fe264a16",
    "R2_BUCKET_NAME": "mixetape-media",
    // The bucket's custom domain: every stored file is public at MEDIA_PUBLIC_URL/<key>.
    "MEDIA_PUBLIC_URL": "https://media.mixetape.com",
  },
}
